void calculate()

{

    printf("\n**\n");

    printf("****** Monthly Expense Calculator ********\n");

    printf("\n");

    char name[100][100];

    double amount[100],total=0,person;

    int n,i,members;

    printf("\nHow many types of expenses do you want to calculate?\n");

    scanf("%d",&n);

    for(i=0;i<n;i++)

    {

        printf("\nEnter expense name: ");

        scanf(" %[^\n]", name[i]);

        printf("\nEnter amount for %s: ", name[i]);

        scanf("%lf",&amount[i]);

        total += amount[i];

    }

    printf("\n*Expense List*\n");

    for(i=0;i<n;i++)

    {

        printf("%s : %.2lf\n",name[i],amount[i]);

    }

    printf("\nEnter number of members: ");

    scanf("%d",&members);

    person = (total/members);

    printf("\n******* Final Result **********\n");

    printf("\n Per Person Expense (for %d people) = %.2lf\n",members,person);

}



void savings()

{

    printf("\n**\n");

    printf("******* Yearly Savings Calculator ********\n");

    printf("\n");

    char months[12][10]=

    {

        "January","February","March","April",

        "May","June","July","August","September",

        "October","November","December"

    };

    double FixedCost,RunningCost,Loan=0,Profit=0,MonthlySaving;

    double YearlySaving,FinalSaving;

    printf("\n*Note: An advance of 1000 taka has been taken for urgent needs.*\n");

    printf("\nEnter fixed monthly cost per person: ");

    scanf("%lf",&FixedCost);

    for(int i=0; i<12; i++)

    {

        printf("Enter running cost for %s: ", months[i]);

        scanf("%lf",&RunningCost);

        if(RunningCost>FixedCost)

        {

            Loan += (RunningCost-FixedCost);

        }

        else if(RunningCost<FixedCost)

        {

            Profit += (FixedCost-RunningCost);

        }

    }

    printf("\nEnter fixed saving amount for each month: ");

    scanf("%lf",&MonthlySaving);

    YearlySaving = (MonthlySaving*12);

    FinalSaving = (YearlySaving + Profit) - Loan + 1000;

    printf("\n**YEAR END REPORT\n");

    printf("Total Loan (extra cost) = %.2lf\n", Loan);

    printf("Total Profit (saved amount) = %.2lf\n", Profit);

    printf("Total Yearly Saving (from monthly saving) = %.2lf\n",YearlySaving);

    printf("Advance taken for urgent needs = 1000.00\n");

    printf("------------------------------------------\n");

    printf("\nFinal Remaining Saving After Adjustment = %.2lf\n",FinalSaving);

}

int ChangePassword(char pass[])

{

    char oldPass[50], newPass[50];

    printf("\nEnter old password: ");

    scanf("%s", oldPass);

    if(strcmp(oldPass, pass) == 0)

    {

        printf("Enter new password: ");

        scanf("%s", newPass);

        strcpy(pass, newPass);   // Direct update

        printf("Password changed successfully!\n");

        return 1;

    }

    else

    {

        printf("Incorrect old password!\n");

        return 0;

    }

}

